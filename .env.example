# Local development only. Use distinct, long random values; never commit .env.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Versioned image tags can be overridden here. Review and update regularly.
BOOKORA_DB_IMAGE=mysql:8.0.44
BOOKORA_WORDPRESS_IMAGE=wordpress:6.8.3-php8.2-apache
# Optional: store/product IDs from the license issuer, not an API key.
BOOKORA_LICENSE_STORE_ID=
BOOKORA_LICENSE_PRODUCT_ID=
